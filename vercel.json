{
    "version": 2,
    "builds": [
        { "src": "api/index.php", "use": "vercel-php@0.7.1" }
    ],
    "routes": [
        { "src": "/build/(.*)", "dest": "/public/build/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "CACHE_STORE": "file",
        "SESSION_DRIVER": "file",
        "LOG_CHANNEL": "stderr"
    }
}
